# Copy to .env for docker compose, then fill in real values. Never commit .env.

# host port for the web container (the api is not published)
WEB_PORT=8080

# api settings — every key is read with the CHAT_ prefix
CHAT_ENVIRONMENT=production
CHAT_SECRET_KEY=change-me-before-you-start
CHAT_ACCESS_TOKEN_TTL_MINUTES=60
# JSON list, quoted because it goes through compose interpolation
CHAT_CORS_ORIGINS=["http://localhost:8080"]

# web build-time setting: relative path, nginx proxies /api to the api container
VITE_API_BASE_URL=/api

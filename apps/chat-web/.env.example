# Where the API lives. Relative by default: the vite dev proxy (or nginx in
# production) forwards /api and /ws to the API container.
VITE_API_URL=/api

# Only for `npm run dev`: where the dev proxy sends /api and /ws.
# Defaults to http://127.0.0.1:8000 when unset.
VITE_API_PROXY_TARGET=http://127.0.0.1:8000

# The compose build passes VITE_API_BASE_URL; both are read, VITE_API_URL wins.
# VITE_API_BASE_URL=/api
